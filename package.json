{
  "name": "agrogestor",
  "version": "2.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.8",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.14",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/copy-web.js",
    "desktop": "npm run build:web && npm --prefix desktop start",
    "build:win": "npm run build:web && npm --prefix desktop run dist",
    "build:apk": "eas build --platform android --profile preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "private": true
}
