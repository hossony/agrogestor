# Banco Postgres (Neon). A integração da Vercel preenche sozinha.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Segredo das sessões: qualquer texto longo e aleatório (openssl rand -base64 32).
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Vercel Blob (imagens e vídeos). A integração da Vercel preenche sozinha.
# Sem ele, em desenvolvimento os arquivos vão para public/uploads.
BLOB_READ_WRITE_TOKEN=

# Notificações push (gere com: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
