{
  "expo": {
    "name": "AgroGestor",
    "slug": "agrogestor",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12301F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elielfilho.agrogestor"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "backgroundColor": "#EDF1EA",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O AgroGestor usa suas fotos para anexar imagens aos registros, máquinas e animais.",
          "cameraPermission": "O AgroGestor usa a câmera para gravar vídeos dos trabalhos no campo para o diário.",
          "microphonePermission": "O AgroGestor usa o microfone para gravar o som dos vídeos do diário."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E6B3E"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "cba5be90-8ec3-4a1e-8372-042f42e66e8b"
      }
    }
  }
}
